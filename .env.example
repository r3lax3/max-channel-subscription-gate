debug=false

database_url=postgresql+asyncpg://maxgate:maxgate@postgres:5432/maxgate

# Токен бота MAX (business.max.ru → Чат-боты → Интеграция)
bot_token=YOUR_MAX_BOT_TOKEN

# MAX user_id владельцев (доступ к /admin), JSON-список
owner_ids=[]

support_link=https://max.ru/your_support
# Ссылка на бота — сюда Prodamus вернёт после оплаты
bot_link=https://max.ru/your_bot

# chat_id закрытых ГРУППОВЫХ чатов, JSON-список (каналы закрыть нельзя, docs/adr/0001).
# Бот должен быть админом с правами «читать все сообщения» и «удалять участников».
# chat_id бот пришлёт владельцам, когда его добавят в группу.
gated_chat_ids=[]
# Ссылки-приглашения в клуб для оплативших, JSON-список. Пусто — бот возьмёт из чата.
invite_links=[]
# Сверять участников с базой раз в час и удалять неоплативших
reconcile_members=false

# Цена руб/месяц; квартал (-10%) и полгода (-15%) считаются от неё
subscription_price=2000
# Цена для «старичков» (непрерывная подписка, оплаченная во время акции)
subscription_price_legacy=1500
# Окончание акции «по старой цене», пусто — выключена
legacy_promo_until=

prodamus_domain=your-domain.payform.ru
prodamus_secret_key=YOUR_PRODAMUS_SECRET_KEY
# Публичный URL вебхука Prodamus этого бота
prodamus_notification_url=https://your-domain.com/maxgate/prodamus/webhook

# Webhook MAX (production): HTTPS-URL на 443-м порту и секрет [A-Za-z0-9_-]{5,256}.
# Пусто — long polling.
max_webhook_url=
max_webhook_secret=

webhook_port=8080
