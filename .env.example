debug=false

database_url=postgresql+asyncpg://maxgate:maxgate@postgres:5432/maxgate

# Токен бота MAX (business.max.ru → Чат-боты → Интеграция)
bot_token=YOUR_MAX_BOT_TOKEN

# MAX user_id владельцев (доступ к /admin), JSON-список
owner_ids=[]

support_link=https://max.ru/your_support
# Ссылка на бота — сюда Prodamus вернёт после оплаты
bot_link=https://max.ru/your_bot

# chat_id закрытых чатов (группа и/или канал), JSON-список.
# Бот должен быть в них администратором.
gated_chat_ids=[]

# Цена руб/месяц; квартал (-10%) и полгода (-15%) считаются от неё
subscription_price=2000
# Цена для «старичков» (непрерывная подписка, оплаченная во время акции)
subscription_price_legacy=1500
# Окончание акции «по старой цене», пусто — выключена
legacy_promo_until=

prodamus_domain=your-domain.payform.ru
prodamus_secret_key=YOUR_PRODAMUS_SECRET_KEY

webhook_port=8080
